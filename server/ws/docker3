services:
  websocket:
    build: .
    container_name: forkex-ws
    restart: unless-stopped
    environment:
      - WS_PORT=10011
      - WS_VERBOSE=1
      - JWT_SECRET=supersecret123
      - REDIS_HOST=forkex-redis
      - REDIS_PASSWORD=bitholla
      - PUBSUB_HOST=forkex-redis
      - PUBSUB_PASSWORD=bitholla
    ports:
      - "10011:10011"
    networks:
      - forkex-network

networks:
  forkex-network:
    external: true
    name: forkex-network
