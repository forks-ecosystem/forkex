'use strict';

const { Balance, Coin } = require('../db/models');
const getUserBalanceUtils = async (params) => {
  const { user_id, limit = 50, page = 1 } = params.query;
  if (!user_id) { throw new Error('user_id is required'); }
  try {
    const balances = await Balance.findAll({
      where: { user_id },
      order: [['updated_at', 'DESC']],
      limit: parseInt(limit),
      offset: (parseInt(page) - 1) * parseInt(limit),
      include: [{
        model: Coin,
        as: 'coin',
        attributes: ['symbol']
      }]
    });
//id: d.id,
//user_id: d.user_id,  
    const formatted = balances.map(d => ({
      currency: d.currency,
      balance: parseFloat(d.balance),
      available: parseFloat(d.available),
      pending: Number((d.balance - d.available).toFixed(8)),
      updated_at: d.updated_at,
      coin_symbol: d.coin?.symbol || null
    }));
    const flat = {};
    formatted.forEach(({ currency, balance, available, pending }) => {
      flat[`${currency}_balance`] = balance;
      flat[`${currency}_available`] = available;
      flat[`${currency}_pending`] = pending;
    });

    return { data: formatted ...flat}; 
  } catch (error) {
    console.error('GET /api/v2/user/balance error:', error);
    throw new Error('Failed to fetch balances');
  }
};
module.exports = {
  getUserBalanceUtils
};
