// /opt/hollaex-kit/server/utils/orderbook.js
'use strict';

const { Order, Pair } = require('../db/models');
const Sequelize = require('sequelize');
const { Op } = Sequelize;

const getOrderbookUtils = async (params) => {
  const { symbol, limit = 50 } = params.query;

  if (!symbol) throw new Error('symbol is required');

  try {
    const pair = await Pair.findOne({ where: { symbol } });
    if (!pair) throw new Error(`Pair ${symbol} not found`);

    const bids = await Order.findAll({
      where: {
        pair_id: pair.id,
        side: 'buy',
        status: 'open'
      },
      order: [['price', 'DESC']],
      limit: parseInt(limit)
    });

    const asks = await Order.findAll({
      where: {
        pair_id: pair.id,
        side: 'sell',
        status: 'open'
      },
      order: [['price', 'ASC']],
      limit: parseInt(limit)
    });

    return {
      symbol,
      bids: bids.map(b => [parseFloat(b.price), parseFloat(b.size)]),
      asks: asks.map(a => [parseFloat(a.price), parseFloat(a.size)])
    };
  } catch (error) {
    console.error('Error fetching orderbook:', error);
    throw new Error('Failed to fetch orderbook');
  }
};

module.exports = {
  getOrderbookUtils
};
