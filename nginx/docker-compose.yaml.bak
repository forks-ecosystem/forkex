services:
  nginx:
    container_name: forkex-nginx
    build:
      context: .
      dockerfile: Dockerfile
    restart: unless-stopped
    volumes:
      - ./nginx.conf:/etc/nginx/nginx.conf:ro
      - ./proxy.conf:/etc/nginx/proxy.conf:ro
      - ./logs:/var/log/nginx
      - ./static:/usr/share/nginx/html
      - ./letsencrypt:/etc/nginx/letsencrypt:ro
    ports:
      - "80:80"
      - "443:443"
    networks:
      - forkex-network

networks:
  forkex-network:
    external: true
