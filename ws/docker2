version: '3.9'

services:
  forkex-ws:
    build: .
    container_name: forkex-ws
    restart: unless-stopped
    environment:
      WS_PORT: 10080
      WS_VERBOSE: "1"
      JWT_SECRET: supersecret123
      REDIS_HOST: forkex-redis
      REDIS_PORT: 6379
      REDIS_PASSWORD: bitholla
      PUBSUB_HOST: forkex-redis
      PUBSUB_PORT: 6379
      PUBSUB_PASSWORD: bitholla
    ports:
      - "10011:10080"
    networks:
      - forkex-network

networks:
  forkex-network:
    external: true
    name: forkex-network
