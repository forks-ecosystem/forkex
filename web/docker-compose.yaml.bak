name: "client"
services:
  forkex-web:
    container_name: forkex-web
    image: forkex-web
    build:
      context: .
      dockerfile: docker/Dockerfile
    restart: always
    env_file:
      - /opt/forkex/.env
    ports: 
      - 8080:80 
    networks:
      - forkex-network
      
networks:
  forkex-network:
    external: true

