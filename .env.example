# Скопируйте этот файл в .env и заполните значения.
#   cp .env.example .env
# .env находится в .gitignore и никогда не коммитится.

# ─── База данных (postgres) ─────────────────────────────
DB_DIALECT=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hollaex
DB_USERNAME=admin
DB_PASSWORD=
DB_SSL=
DB_DSN=

POSTGRES_USER=admin
POSTGRES_PASSWORD=

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── Безопасность / JWT ─────────────────────────────────
JWT_SECRET=
SECRET_KEY=
SECRET=

# ─── Домен ───────────────────────────────────────────────
DOMAIN=forkex.life
NETWORK_URL=https://forks.life

# ─── API ────────────────────────────────────────────────
API_NAME=forkex
API_KEY=
API_SECRET=
HTTP_PORT=10010
PORT=10010
API_PORT=10010
DISABLE_CAPTCHA=false
NEW_USER_IS_ACTIVATED=true
NEW_USER_DEFAULT_LANGUAGE=en
USER_LEVEL_NUMBER=1
KIT_VERSION=2.17.0
BaseURL=https://forkex.life

# ─── WebSocket ──────────────────────────────────────────
WS_PORT=10011
WS_VERBOSE=false
WS_INTERNAL_URL=ws://websocket:10011/stream

# ─── Плагины ────────────────────────────────────────────
PLUGIN_PORT=10012

# ─── Публичные URL ──────────────────────────────────────
PUBLIC_API_URL=https://forkex.life
PUBLIC_WS_URL=wss://forkex.life/stream

# ─── Сеть (p2p) ─────────────────────────────────────────
NETWORK=
CURRENCIES=
PAIRS=

# ─── Оформление / локализация ───────────────────────────
DEFAULT_THEME=light
VALID_LANGUAGES=en,ru,ko,zh,ja
LOGO_IMAGE=

# ─── Почта (SMTP) ───────────────────────────────────────
SUPPORT_EMAIL=
EMAILS_TIMEZONE=Asia/Shanghai
SEND_EMAIL_TO_SUPPORT=true
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ─── Торговые боты (forkex-bot) ─────────────────────────
BINANCE_POLL_INTERVAL=
FORK_POLL_INTERVAL=
RELOAD_INTERVAL=
LOG_LEVEL=info
